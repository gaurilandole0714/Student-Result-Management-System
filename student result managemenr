import tkinter as tk
from itkinter import ttk, messagebox
from openpyxl import Workbook, load_workbook
import os


EXCEL_FILE = "student_results.xlsx"


# ---------------- Excel File Setup ----------------

def create_excel_file():
    if not os.path.exists(EXCEL_FILE):
        workbook = Workbook()
        sheet = workbook.active
        sheet.title = "Student Results"

        headers = [
            "Name",
            "Roll No.",
            "Class",
            "Subject 1",
            "Subject 2",
            "Subject 3",
            "Subject 4",
            "Subject 5",
            "Total Marks",
            "Percentage",
            "Result"
        ]

        sheet.append(headers)
        workbook.save(EXCEL_FILE)


# ---------------- Add Student ----------------

def add_student():
    name = name_entry.get().strip()
    roll_no = roll_entry.get().strip()
    student_class = class_entry.get().strip()

    marks_entries = [
        sub1_entry,
        sub2_entry,
        sub3_entry,
        sub4_entry,
        sub5_entry
    ]

    # Check empty fields
    if not name or not roll_no or not student_class:
        messagebox.showerror("Error", "Please enter all student details.")
        return

    # Check roll number
    if not roll_no.isdigit():
        messagebox.showerror("Error", "Roll No. must be a number.")
        return

    # Get marks
    try:
        marks = [float(entry.get()) for entry in marks_entries]
    except ValueError:
        messagebox.showerror("Error", "Please enter valid marks.")
        return

    # Check marks range
    for mark in marks:
        if mark < 0 or mark > 100:
            messagebox.showerror(
                "Error",
                "Marks must be between 0 and 100."
            )
            return

    # Check duplicate roll number
    workbook = load_workbook(EXCEL_FILE)
    sheet = workbook.active

    for row in sheet.iter_rows(min_row=2, values_only=True):
        if str(row[1]) == roll_no:
            messagebox.showerror(
                "Error",
                "This Roll No. already exists."
            )
            workbook.close()
            return

    # Calculate total and percentage
    total = sum(marks)
    percentage = total / 5

    # Pass/Fail
    if all(mark >= 35 for mark in marks):
        result = "Pass"
    else:
        result = "Fail"

    # Save to Excel
    sheet.append([
        name,
        int(roll_no),
        student_class,
        *marks,
        total,
        percentage,
        result
    ])

    workbook.save(EXCEL_FILE)
    workbook.close()

    messagebox.showinfo(
        "Success",
        "Student record saved successfully!"
    )

    clear_fields()


# ---------------- Get Result ----------------

def get_result():
    roll_no = search_roll_entry.get().strip()

    if not roll_no:
        messagebox.showerror(
            "Error",
            "Please enter Roll No."
        )
        return

    if not roll_no.isdigit():
        messagebox.showerror(
            "Error",
            "Roll No. must be a number."
        )
        return

    workbook = load_workbook(EXCEL_FILE)
    sheet = workbook.active

    for row in sheet.iter_rows(min_row=2, values_only=True):
        if str(row[1]) == roll_no:

            result_text = (
                f"Name: {row[0]}\n"
                f"Roll No.: {row[1]}\n"
                f"Class: {row[2]}\n"
                f"Total Marks: {row[8]}\n"
                f"Percentage: {row[9]:.2f}%\n"
                f"Result: {row[10]}"
            )

            messagebox.showinfo(
                "Student Result",
                result_text
            )

            workbook.close()
            return

    workbook.close()

    messagebox.showerror(
        "Not Found",
        "Student record not found."
    )


# ---------------- Show All Results ----------------

def show_all_results():
    # Clear existing rows
    for item in result_tree.get_children():
        result_tree.delete(item)

    workbook = load_workbook(EXCEL_FILE)
    sheet = workbook.active

    for row in sheet.iter_rows(min_row=2, values_only=True):

        if row[0] is not None:
            result_tree.insert(
                "",
                tk.END,
                values=(
                    row[0],
                    row[1],
                    row[2],
                    row[8],
                    f"{row[9]:.2f}%",
                    row[10]
                )
            )

    workbook.close()


# ---------------- Clear Fields ----------------

def clear_fields():
    name_entry.delete(0, tk.END)
    roll_entry.delete(0, tk.END)
    class_entry.delete(0, tk.END)

    sub1_entry.delete(0, tk.END)
    sub2_entry.delete(0, tk.END)
    sub3_entry.delete(0, tk.END)
    sub4_entry.delete(0, tk.END)
    sub5_entry.delete(0, tk.END)


# ---------------- Exit ----------------

